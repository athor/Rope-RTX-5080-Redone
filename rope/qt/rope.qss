/* Rope-Pearl Qt stylesheet — dark 3-tier palette ported from rope/Styles.py.
   Tier 1 (#17181A) = outer chrome (top bar, bottom bar)
   Tier 2 (#212126) = mid-level frames, timeline canvas
   Tier 3 (#28282E) = inner panels (lists, params, info labels)
*/

QWidget {
    color: #D0D0D0;
    font: 9pt "Segoe UI";
    background-color: #17181A;
}

QFrame[panelTier="1"] { background-color: #17181A; }
QFrame[panelTier="2"] { background-color: #212126; }
QFrame[panelTier="3"] { background-color: #28282E; }

QLabel { background: transparent; color: #D0D0D0; }
QLabel[role="info"] {
    background-color: #28282E;
    color: #FFFFFF;
    padding: 5px;
}

QPushButton {
    background-color: #28282E;
    color: #FFFFFF;
    border: 0;
    padding: 4px 10px;
    font: 10pt "Segoe UI";
}
QPushButton:hover  { color: #B1B1B2; }
QPushButton:disabled { color: #828282; }
QPushButton:checked,
QPushButton[state="on"]  { color: #E5B854; background-color: #313137; }
QPushButton[state="error"] { color: lightgoldenrodyellow; }
QPushButton[role="media"]:checked { background-color: #d10303; }
QPushButton[role="topAction"] {
    background-color: #35353D;
    border: 1px solid #55555F;
    border-radius: 3px;
}
QPushButton[role="topAction"]:hover {
    background-color: #41414B;
    border-color: #737380;
}
QPushButton[role="topAction"]:pressed {
    background-color: #1F1F24;
    border-color: #E5B854;
}
QPushButton[role="topAction"][state="on"] {
    color: #E5B854;
    background-color: #313137;
    border-color: #E5B854;
}
QPushButton[role="faceAction"] {
    background-color: #35353D;
    border: 1px solid #5A5A62;
    border-radius: 3px;
}
QPushButton[role="faceAction"]:hover {
    background-color: #414149;
    border-color: #85858D;
    color: #FFFFFF;
}
QPushButton[role="faceAction"]:pressed {
    background-color: #17181A;
    border-color: #E5B854;
}
QPushButton[role="faceAction"][state="on"] {
    background-color: #4A412A;
    border-color: #E5B854;
    color: #E5B854;
}

QLineEdit {
    background-color: #1F1F1F;
    color: #FFFFFF;
    border: 1px solid #17181A;
    padding: 2px 4px;
    selection-background-color: #404040;
    selection-color: #E5B854;
}

QSlider { min-height: 30px; }
QSlider::groove:horizontal,
QSlider::sub-page:horizontal,
QSlider::add-page:horizontal {
    height: 16px;
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #252A31, stop:0.18 #101318,
        stop:0.5 #171B21, stop:0.82 #090B0E, stop:1 #30363F
    );
    border: 1px solid #444950;
    border-radius: 8px;
}
QSlider::handle:horizontal {
    width: 10px;
    margin: -7px 0;
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #747D89, stop:0.18 #5F6773,
        stop:0.55 #454C57, stop:1 #2F3641
    );
    border-top: 1px solid #8D959F;
    border-left: 1px solid #69727E;
    border-right: 1px solid #171B21;
    border-bottom: 1px solid #101318;
    border-radius: 2px;
}
QSlider::handle:horizontal:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #87919D, stop:0.2 #6E7783,
        stop:0.6 #4B535E, stop:1 #333A45
    );
    border-top-color: #AAB1B9;
    border-left-color: #858E98;
}
QSlider::handle:horizontal:pressed {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #343B45, stop:0.45 #464E59, stop:1 #68717C
    );
    border-top-color: #14171B;
    border-left-color: #171A1F;
    border-right-color: #747D87;
    border-bottom-color: #8B939C;
}

QScrollBar:vertical {
    background-color: #212126;
    width: 14px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background-color: #404040;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover { background-color: #5A5A5A; }
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0; background: none; }
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical { background: none; }

QScrollBar:horizontal {
    background-color: #212126;
    height: 14px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background-color: #404040;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover { background-color: #5A5A5A; }
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal { width: 0; background: none; }
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal { background: none; }

QTabWidget::pane {
    background-color: #28282E;
    border: 1px solid #3A3A42;
    margin: 0;
    padding: 0;
}
QTabWidget::tab-bar { left: 0; }
QTabBar::tab {
    background-color: #212126;
    color: #C8C8CC;
    border: 1px solid #3A3A42;
    border-bottom: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    min-width: 105px;
    padding: 7px 14px;
    margin-right: 3px;
}
QTabBar::tab:hover {
    background-color: #35353D;
    color: #FFFFFF;
    border-color: #5A5A62;
}
QTabBar::tab:selected {
    background-color: #3B3527;
    color: #E5B854;
    border-color: #E5B854;
}
QTabBar::tab:!selected { margin-top: 3px; }

QSplitter::handle { background-color: #17181A; }
QSplitter::handle:horizontal { width: 3px; }
QSplitter::handle:vertical { height: 3px; }

QProgressBar {
    background-color: #1F1F1F;
    border: 0;
    text-align: center;
    color: #FFFFFF;
}
QProgressBar::chunk { background-color: #B1B1B2; }
QProgressBar[overLimit="true"]::chunk { background-color: #D10303; }

QToolTip {
    background-color: #28282E;
    color: #FFFFFF;
    border: 1px solid #090909;
    padding: 4px;
}
